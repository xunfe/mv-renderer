let SHOTS = [];
function buildShots() {
  SHOTS = ROWS.map((row, i) => {
    const L = LINES[i];
    return { t: Math.max(0, L.s - 0.05), line: i, m: row[0], kw: row[1], ch: row[2], cam: [row[3], row[4]], tr: row[5], opt: row[6] || {} };
  });
}
function shotIndex(T) {
  let lo = 0, hi = SHOTS.length - 1;
  while (lo < hi) { const m = (lo + hi + 1) >> 1; if (SHOTS[m].t <= T) lo = m; else hi = m - 1; }
  return lo;
}

/* ---------------- 通用画笔 ---------------- */
function inkPaper(t, o = {}) {
  ctx.fillStyle = lin(ctx, 0, 0, W, H, [[0, '#0a1418'], [0.55, '#081014'], [1, '#050a0d']]);
  ctx.fillRect(0, 0, W, H);
  ctx.save(); ctx.globalAlpha = 0.5;
  ctx.fillStyle = rad(ctx, o.x || 900, o.y || 540, 1100, [[0, 'rgba(38,66,72,0.55)'], [1, 'rgba(6,12,16,0)']]);
  ctx.fillRect(0, 0, W, H); ctx.restore();
  for (let i = 0; i < 90; i++) {
    ctx.globalAlpha = 0.04 + rnd(i, 2) * 0.06;
    ctx.fillStyle = rnd(i, 3) > 0.5 ? '#9fb8b4' : '#2a3e42';
    ctx.fillRect(rnd(i, 4) * W, rnd(i, 5) * H, 1 + rnd(i, 6) * 40, 1);
  }
  ctx.globalAlpha = 1;
}
function drawBigGlyph(g, ch, x, y, size, color) {
  g.save(); g.font = font(size, 600, SERIF); g.textAlign = 'center'; g.textBaseline = 'middle';
  g.fillStyle = color; g.fillText(ch, x, y); g.restore();
}
function brushInk(g, x, y, rot, s) {
  g.save(); g.translate(x, y); g.rotate(rot); g.scale(s, s);
  g.fillStyle = '#6b4a2c'; rrect(g, -8, -420, 16, 300, 8); g.fill();
  g.fillStyle = '#c8a06a'; rrect(g, -11, -150, 22, 40, 6); g.fill();
  g.fillStyle = '#14100c';
  g.beginPath(); g.moveTo(-14, -110); g.quadraticCurveTo(-16, -40, 0, 12); g.quadraticCurveTo(16, -40, 14, -110); g.fill();
  g.restore();
}
function brush(g, x, y, rot, s, t) {
  g.save(); g.translate(x, y); g.rotate(rot); g.scale(s, s);
  g.fillStyle = '#6b4a2c'; rrect(g, -8, -420, 16, 300, 8); g.fill();
  g.fillStyle = '#c8a06a'; rrect(g, -11, -150, 22, 40, 6); g.fill();
  g.fillStyle = '#1a1410';
  g.beginPath(); g.moveTo(-14, -110); g.quadraticCurveTo(-16, -40, 0, 12); g.quadraticCurveTo(16, -40, 14, -110); g.fill();
  g.restore();
}

/* ---------------- 渲染 ---------------- */
function renderFrame(outT) {
  const T = clamp(outT, 0, window.DUR) + OFF;
  const i = shotIndex(T);
  const S = SHOTS[i];
  const u = T - S.t;
  const dur = (SHOTS[i + 1] ? SHOTS[i + 1].t : window.DUR + OFF) - S.t;
  const p = dur > 0 ? clamp(u / dur) : 0;
  const e = { u, T, p, dur, i, S, kw: S.kw, R: S.opt || {} };
  ctx.setTransform(SS, 0, 0, SS, 0, 0);
  ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
  ctx.clearRect(0, 0, W, H);
  const push = beatPulse(T, 5) * 0.004;
  const z = lerp(S.cam[0], S.cam[1], E.soft(p)) + push;
  ctx.save();
  ctx.translate(W / 2, H / 2); ctx.scale(z, z); ctx.translate(-W / 2, -H / 2);
  const fn = M[S.m] || M.bigTitle;
  const R = Object.assign({}, S.opt || {}, { kw: S.kw });
  try { fn(e, R); } catch (err) { if (typeof console !== 'undefined') console.error('shot error', S.m, err); }
  ctx.restore();
  if (S.tr === 'fade') {
    const a = 1 - sat(u, 0, 0.42);
    if (a > 0) { ctx.fillStyle = `rgba(3,7,10,${a * 0.95})`; ctx.fillRect(0, 0, W, H); }
  } else if (S.tr === 'flash') {
    const a = Math.max(0, 1 - u / 0.26) * 0.5;
    if (a > 0) { ctx.fillStyle = `rgba(255,240,214,${a})`; ctx.fillRect(0, 0, W, H); }
  }
  if (!CLEAN && !COVER) drawLyric(T);
  vignette(ctx, 0.34);
  grain(ctx, grainTex, T, 0.035);
  const fadeOut = sat(outT, window.DUR - 2.6, window.DUR - 0.2);
  if (fadeOut > 0) { ctx.fillStyle = `rgba(3,6,9,${fadeOut})`; ctx.fillRect(0, 0, W, H); }
}

window.seek = (t) => renderFrame(clamp(t, 0, window.DUR - 1e-3));

/* ---------------- 播放 ---------------- */
function preview() {
  const au = new Audio('/mv/world/song/world.mp3');
  au.currentTime = Number(Q.get('t') || 0) + OFF;
  window.mvPlayer({ audio: au, offset: OFF, getSS: () => SS, canvas, hud: document.getElementById('hud') });
  window.addEventListener('resize', () => {
    const k = Math.min(innerWidth / W, innerHeight / H);
    canvas.style.width = (W * k) + 'px'; canvas.style.height = (H * k) + 'px';
  });
  window.dispatchEvent(new Event('resize'));
}

window.__ready = (async () => {
  await loadAll();
  renderFrame(Number(Q.get('t') || 0));
  if (RENDER) { const st = document.getElementById('start'); if (st) st.classList.add('hide'); }
  if (!RENDER) preview();
  window.__mvLoaded = true;
})();
